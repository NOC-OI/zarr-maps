{
  "name": "zarr-maps-monorepo",
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspace=zarr-maps-colormap && npm run build --workspace=zarr-maps-tiling && npm run build --workspace=zarr-maps-leaflet && npm run build --workspace=zarr-maps-ol",
    "build:colormap": "npm run build --workspace=zarr-maps-colormap",
    "build:tiling": "npm run build --workspace=zarr-maps-tiling",
    "build:leaflet": "npm run build --workspace=zarr-maps-leaflet",
    "build:ol": "npm run build --workspace=zarr-maps-ol",
    "dev:colormap": "npm run dev --workspace=zarr-maps-colormap",
    "dev:tiling": "npm run dev --workspace=zarr-maps-tiling",
    "dev:leaflet": "npm run dev --workspace=zarr-maps-leaflet",
    "dev:ol": "npm run dev --workspace=zarr-maps-ol",
    "clean": "npm run clean --workspaces --if-present",
    "docs": "npm --prefix docs run build",
    "start:demo": "npm --prefix demo run dev"
  }
}
